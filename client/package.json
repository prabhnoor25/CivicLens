    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.52.1",
    "react-leaflet": "4.2.1",
    "react-router-dom": "6.25.1",
    "recharts": "2.12.7",
    "socket.io-client": "4.7.5",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.12",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "autoprefixer": "10.4.19",
